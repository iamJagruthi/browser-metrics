# Copy to .env (same folder) to enable optional/overridable settings.
# Only .env is loaded at runtime; this file is documentation.

# Hosted AI validation service (owns Gemini credentials; no API key needed here).
# Leave unset to keep pure DOM validation with ai_analysis.status = not_configured.
AI_VALIDATION_SERVICE_URL=https://dashboard-comparison-1039491753481.us-east4.run.app/

# Screenshot side folders under output/screenshots/<run_id>/ consumed by the AI service.
SCREENSHOT_SOURCE_FOLDER=SpartanNash
SCREENSHOT_TARGET_FOLDER=Tredence

# Optional page-title keywords used to decide which loaded dashboard is the
# ACTUAL source and which is the ACTUAL target, so the folders above receive
# the correct dashboard regardless of the order the URLs arrive in. Here the
# target page title contains "GCP" while the source does not. Empty means no
# title-based resolution (sides follow request order). Comma-separated.
# SCREENSHOT_SOURCE_TITLE_KEYWORDS=
# SCREENSHOT_TARGET_TITLE_KEYWORDS=GCP

# Folder identifiers the hosted upload endpoint accepts (documented contract).
AI_VALIDATION_SOURCE_FOLDER=spartnash
AI_VALIDATION_TARGET_FOLDER=trendence

# AI comparison polling / invocation bounds (seconds).
AI_COMPARE_POLL_ATTEMPTS=60
AI_COMPARE_POLL_INTERVAL_SECONDS=5
AI_INVOCATION_TIMEOUT_SECONDS=600
# Browser
PROFILE_DIR=
BROWSER_CHANNEL=msedge
HEADLESS=False

# Dashboard
PAGE_TIMEOUT=120000
RENDER_WAIT=10000

# Matrix / table scroll — wider matrices need more horizontal steps
MATRIX_MAX_SCROLL_STEPS=80
SCROLL_STEP_WAIT_MS=400

# Output
OUTPUT_DIR=output
SCREENSHOT_DIR=output/screenshots
REPORT_DIR=output/reports

DASHBOARD_CONFIG=config/dashboards.json

# Gemini
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-3.6-flash

# Optional table comparison
# TABLE_COMPARE_KEY_STRATEGY=auto
# TABLE_COMPARE_KEY_COLUMNS=Product,Month
